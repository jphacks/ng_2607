# このファイルを .env という名前でコピーして値を書きます (cp .env.example .env)。
# .env は Git の管理対象外です。API キーは他人に見せないでください。

# ChatGPT (OpenAI API) の API キー。会話・好感度の判定・自動投稿・DM の自動返信のすべてで使います。
OPENAI_API_KEY=sk-...

# 使うモデル。.venv/bin/python scripts/check_ai.py で、このキーで使えるモデルの一覧を確認できます。
AI_MODEL=

# 好感度の判定だけ別のモデルにしたいとき (空なら AI_MODEL と同じ)
RELATIONSHIP_MODEL=

# Pinksky のストーリー用の画像を作るモデル (空なら gpt-image-2)
IMAGE_MODEL=

# OpenAI 互換の API やプロキシを使うときだけ書きます (空なら https://api.openai.com/v1)
# OPENAI_BASE_URL=
