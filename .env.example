# このファイルを .env という名前でコピーして値を書きます (cp .env.example .env)。
# .env は Git の管理対象外です。API キーは他人に見せないでください。

# ChatGPT (OpenAI API) の API キー。書くと Ollama の代わりに ChatGPT を使います。
OPENAI_API_KEY=sk-...

# 使うモデル。.venv/bin/python scripts/check_ai.py で、このキーで使えるモデルの一覧を確認できます。
AI_MODEL=

# 好感度の判定だけ別のモデルにしたいとき (空なら AI_MODEL と同じ)
RELATIONSHIP_MODEL=

# Ollama に戻すときは OPENAI_API_KEY を消すか、次の行を有効にします。
# AI_PROVIDER=ollama
